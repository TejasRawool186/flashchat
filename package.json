{
  "name": "flashchat",
  "version": "1.0.0",
  "description": "Instant temporary messaging and file sharing portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm run dev"
  },
  "keywords": [
    "chat",
    "real-time",
    "file-sharing",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
